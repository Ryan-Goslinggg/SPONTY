# Copy to .env.local for local development. See README > Environment variables.

# Required. Postgres connection string (Neon on Vercel, or any local Postgres 15+).
DATABASE_URL=postgres://postgres@localhost:5432/sponty
# Optional. Direct (non-pooled) connection for migrations and realtime LISTEN. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Required. Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required locally and for custom domains. The app's public URL.
BETTER_AUTH_URL=http://localhost:3000

# Required on Vercel (set automatically when you connect a Blob store). Without it, photos are saved to .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Optional. When set, friend matching uses Claude. Without it, a local heuristic is used.
ANTHROPIC_API_KEY=
# Optional. Overrides the matching model (default claude-opus-5-5).
SPONTY_MATCH_MODEL=
